# Composer
/vendor/

# Drupal core and contrib (installed by Composer)
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# User files
/web/sites/*/files/
/web/sites/*/private/

# Local overrides (never commit secrets)
/web/sites/*/settings.local.php
/web/sites/*/settings.production.php
/web/sites/*/services.local.yml
.env
.env.*
!.env.example
deploy/deploy.env

# Drush
/drush/sites/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Build / misc
node_modules/
*.log
npm-debug.log*
.phpunit.result.cache

# Docker local overrides
docker-compose.override.yml

# Accidental nested DDEV path (overrides belong in .ddev/docker-compose.*.yaml)
.ddev/.ddev/

# Private runtime (outside web root)
/private/*
!/private/.gitkeep

# Optional local tooling
.tool-versions
