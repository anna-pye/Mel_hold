#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)" || exit 70
lib_dir="${script_dir}/../lib"

# shellcheck source=deploy/lib/common.sh
. "${lib_dir}/common.sh"
# shellcheck source=deploy/lib/errors.sh
. "${lib_dir}/errors.sh"
# shellcheck source=deploy/lib/output.sh
. "${lib_dir}/output.sh"
# shellcheck source=deploy/lib/schema.sh
. "${lib_dir}/schema.sh"

usage() {
  cat <<'EOF'
Usage: mel-schema [--format text|json] [--path]

Validate or print the local deployment manifest schema path.

Options:
  --format text|json  Output format. Defaults to text.
  --path              Print the schema path instead of validating JSON syntax.
  --help              Show this help text.
  --version           Show command version.
EOF
}

format="${MEL_OUTPUT_FORMAT:-text}"
print_path=0

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --format)
      if [[ "$#" -lt 2 ]]; then
        mel_error_emit "${MEL_EXIT_USAGE}" "usage" "--format requires a value." "${format}"
        exit $?
      fi
      format="$2"
      shift 2
      ;;
    --path)
      print_path=1
      shift
      ;;
    --help)
      usage
      exit "${MEL_EXIT_OK}"
      ;;
    --version)
      mel_version
      exit "${MEL_EXIT_OK}"
      ;;
    --*)
      mel_error_emit "${MEL_EXIT_USAGE}" "usage" "Unknown option: $1" "${format}"
      exit $?
      ;;
    *)
      mel_error_emit "${MEL_EXIT_USAGE}" "usage" "mel-schema does not accept positional arguments." "${format}"
      exit $?
      ;;
  esac
done

if ! mel_is_supported_output_format "${format}"; then
  mel_error_emit "${MEL_EXIT_USAGE}" "usage" "Unsupported output format: ${format}" "text"
  exit $?
fi

schema_path="$(mel_schema_default_path)" || exit $?

if [[ "${print_path}" -eq 1 ]]; then
  mel_output_kv "schema" "${schema_path}" "${format}"
  exit "${MEL_EXIT_OK}"
fi

if ! mel_require_command python3; then
  mel_error_emit "${MEL_EXIT_DEPENDENCY}" "dependency" "python3 is required for schema validation." "${format}"
  exit $?
fi

schema_output="$(python3 -m json.tool "${schema_path}" >/dev/null 2>&1)"
schema_status=$?
if [[ "${schema_status}" -ne 0 ]]; then
  mel_error_emit "${MEL_EXIT_SCHEMA}" "schema" "Schema JSON is invalid: ${schema_path}" "${format}"
  exit $?
fi

mel_output_status "ok" "schema JSON is valid" "${format}"
