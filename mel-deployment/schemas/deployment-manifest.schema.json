{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myeventlane.example/schemas/deployment-manifest.schema.json",
  "title": "MyEventLane Deployment Manifest",
  "description": "Schema for future deployment manifests consumed by mel-deployment tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment_id",
    "repository",
    "branch",
    "environment",
    "composer_root",
    "document_root",
    "release_root",
    "shared_root",
    "current_link",
    "health_checks"
  ],
  "properties": {
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable deployment target identifier."
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "description": "Source repository URL. No credentials are permitted in this value."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Branch to deploy."
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ],
      "description": "Target deployment environment."
    },
    "composer_root": {
      "type": "string",
      "minLength": 1,
      "description": "Composer root path for the application release context."
    },
    "document_root": {
      "type": "string",
      "minLength": 1,
      "description": "Public document root path for the application release context."
    },
    "release_root": {
      "type": "string",
      "minLength": 1,
      "description": "Root path containing immutable releases."
    },
    "shared_root": {
      "type": "string",
      "minLength": 1,
      "description": "Root path containing shared runtime directories."
    },
    "current_link": {
      "type": "string",
      "minLength": 1,
      "description": "Symlink path that points to the active release."
    },
    "health_checks": {
      "type": "array",
      "minItems": 1,
      "description": "Health checks required before switching current.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "expected_status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Health check URL or path. Secrets are not permitted."
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        }
      }
    }
  }
}
