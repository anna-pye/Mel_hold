    'description' => 'Waitlist subscribers.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
      ],
      'email_normalized' => [
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
      ],
      'first_name' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'interest_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'organisation' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Organisation name, organiser signups only.',
      ],
      'event_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Kind of event the organiser runs.',
      ],
      'next_event_date' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
        'description' => 'Date of their next event, ISO 8601 (YYYY-MM-DD). Format enforced in the form.',
      ],
      'audience_size' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Free text: roughly how many people they can reach.',
      ],
      'current_platform' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Free text: what they use now.',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'pending',
      ],
      'consent_given' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'consent_text' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'consent_version' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'double_opt_in_required' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ],
      'confirm_token' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Hash of confirmation token (raw token never stored).',
      ],
      'confirm_token_expires' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'unsubscribe_token' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'description' => 'Hash of unsubscribe token (raw token never stored).',
      ],
      'source_url' => [
        'type' => 'varchar',
        'length' => 2048,
        'not null' => FALSE,
      ],
      'landing_path' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => FALSE,
      ],
      'referrer' => [
        'type' => 'varchar',
        'length' => 2048,
        'not null' => FALSE,
      ],
      'utm_source' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'utm_medium' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'utm_campaign' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'utm_term' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'utm_content' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'first_touch_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'last_touch_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'user_agent' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
