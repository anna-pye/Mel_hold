      'form_variant' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'locale' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'notes' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => FALSE,
      ],
      'confirmed_at' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'unsubscribed_at' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'last_sent_at' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'changed' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'email_normalized' => ['email_normalized'],
    ],
    'indexes' => [
      'status' => ['status'],
      'created' => ['created'],
      'confirmed_at' => ['confirmed_at'],
      'interest_type' => ['interest_type'],
      'utm_source' => ['utm_source'],
      'utm_campaign' => ['utm_campaign'],
    ],
  ];

  $schema['myeventlane_waitlist_event'] = [
    'description' => 'Audit events for waitlist lifecycle.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'subscriber_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'event_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'payload_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'size' => 'normal',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'subscriber_id' => ['subscriber_id'],
      'event_type' => ['event_type'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function myeventlane_waitlist_uninstall(): void {
  \Drupal::configFactory()->getEditable('myeventlane_waitlist.settings')->delete();
}

/**
 * Use HTML-capable mail plugin so waitlist confirmation emails keep their markup.
 */
function myeventlane_waitlist_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('system.mail');
  $interface = $config->get('interface');
  if (!is_array($interface)) {
    $interface = [];
  }
  $interface['myeventlane_waitlist'] = 'myeventlane_html_php_mail';
  $config->set('interface', $interface)->save();
}

/**
 * Route all mail through the canonical Postmark transport.
 *
 * Supersedes update 11001. The custom myeventlane_html_php_mail plugin has been
 * removed: the contrib Postmark transport already sends bodies as HTML natively,
 * so the plugin was duplicate mail transport. This drops the per-module override
 * installed by 11001 and makes Postmark the single default transport site-wide.
 *
 * Idempotent: on a site that runs 11001 and 11002 in the same `drush updb`, the
 * override 11001 adds is removed here in the same run, so the transient value is
 * never used to send mail.
 */
function myeventlane_waitlist_update_11002(): void {
  $config = \Drupal::configFactory()->getEditable('system.mail');
  $interface = $config->get('interface');
  if (!is_array($interface)) {
    $interface = [];
  }
  unset($interface['myeventlane_waitlist']);
  $interface['default'] = 'postmark';
  $config->set('interface', $interface)->save();
}

/**
 * Add organiser profile columns to the waitlist subscriber table.
 */
function myeventlane_waitlist_update_11003(): void {
  $schema = \Drupal::database()->schema();
  $table = 'myeventlane_waitlist_subscriber';

  $columns = [
    'organisation' => [
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'description' => 'Organisation name, organiser signups only.',
    ],
    'event_type' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Kind of event the organiser runs.',
    ],
    'next_event_date' => [
      'type' => 'varchar',
      'length' => 32,
      'not null' => FALSE,
      'description' => 'Date of their next event, ISO 8601 (YYYY-MM-DD).',
    ],
    'audience_size' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Free text: roughly how many people they can reach.',
    ],
    'current_platform' => [
      'type' => 'varchar',
      'length' => 128,
      'not null' => FALSE,
      'description' => 'Free text: what they use now.',
    ],
  ];

  foreach ($columns as $name => $spec) {
    if (!$schema->fieldExists($table, $name)) {
      $schema->addField($table, $name, $spec);
    }
  }
}
