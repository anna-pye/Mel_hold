{#
/**
 * @file
 * Front page — aligned with index-2.html (glassmorphism, two-column grid).
 */
#}
<a class="mel-skip" href="#main-content">{{ 'Skip to content'|t }}</a>
<div class="mel-wrap">
  <div class="mel-messages mel-messages--top" role="status" aria-live="polite">
    {{ mel_messages }}
  </div>

  <header class="mel-header">
    <div class="mel-topbar">
      <a class="mel-brand" href="{{ path('<front>') }}" aria-label="{{ 'MyEventLane home'|t }}">
        <div class="mel-logo-mark" aria-hidden="true"></div>
        <div>
          <div class="mel-brand-name">{{ 'MyEventLane'|t }}</div>
          <span class="mel-brand-sub">{{ mel_brand_subtitle }}</span>
        </div>
      </a>

      <div class="mel-pill" role="status" aria-live="polite">
        <span class="mel-pill-dot" aria-hidden="true"></span>
        {{ mel_hero_kicker }}
      </div>
    </div>
  </header>

  <main id="main-content" class="mel-main" role="main">
    <div class="mel-grid">
      <section class="mel-card mel-hero" aria-labelledby="mel-hero-title">
        <div class="mel-sparkles" aria-hidden="true"></div>

        <h1 id="mel-hero-title" class="mel-hero-title">
          <span class="mel-gradient-text">{{ mel_hero_gradient }}</span><br />
          {{ mel_hero_subheading }}
        </h1>

        <p class="mel-lead">{{ mel_hero_lead }}</p>

        {% if mel_badge_items is not empty %}
          <ul class="mel-badges" aria-label="{{ 'What is landing first'|t }}">
            {% for item in mel_badge_items %}
              <li class="mel-badge">
                <span class="mel-icon" aria-hidden="true">
                  {% if item.icon == 'calendar' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18"></path><path d="M7 3v4"></path><path d="M17 3v4"></path><rect x="3" y="7" width="18" height="14" rx="2"></rect><path d="M7 11h4"></path></svg>
                  {% elseif item.icon == 'ticketing' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="7" cy="7" r="2"></circle><circle cx="17" cy="17" r="2"></circle></svg>
                  {% elseif item.icon == 'pin' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 6-9 12-9 12S3 16 3 10a9 9 0 0 1 18 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4-9 4-9-4 9-4Z"></path><path d="M3 10l9 4 9-4"></path><path d="M3 18l9 4 9-4"></path></svg>
                  {% endif %}
                </span>
                {{ item.main }}{% if item.sub %} <span>• {{ item.sub }}</span>{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <aside class="mel-card mel-side" aria-label="{{ 'Stay in the loop'|t }}">
        <div class="mel-panel">
          <h2 class="mel-panel__h">{{ 'Get launch updates'|t }}</h2>
          <p class="mel-panel__p">{{ mel_waitlist_intro }}</p>
          {{ waitlist_form }}
        </div>

        <div class="mel-panel">
          <h2 class="mel-panel__h">{{ 'What’s next'|t }}</h2>
          <p class="mel-panel__p">{{ mel_whats_next_intro }}</p>

          <div class="mel-links" aria-label="{{ 'Contact options'|t }}">
            <a class="mel-pill-cta" href="{{ path('myeventlane_waitlist.contact') }}">
              {{ 'Contact MyEventLane'|t }}
            </a>
            {% if mel_instagram_url %}
              <a class="mel-linkbtn" href="{{ mel_instagram_url }}" rel="noopener noreferrer" target="_blank" aria-label="{{ 'Follow on Instagram'|t }}">
                📷 <strong>{{ 'Instagram'|t }}</strong> <span>{{ mel_instagram_label }}</span>
              </a>
            {% endif %}
            {% if mel_linkedin_url %}
              <a class="mel-linkbtn" href="{{ mel_linkedin_url }}" rel="noopener noreferrer" target="_blank" aria-label="{{ 'Follow on LinkedIn'|t }}">
                💼 <strong>{{ 'LinkedIn'|t }}</strong> <span>{{ mel_linkedin_label }}</span>
              </a>
            {% endif %}
          </div>
        </div>
      </aside>
    </div>
  </main>

  <footer class="mel-foot-wrap" role="contentinfo">
    <div class="mel-foot">
      <div>{{ mel_footer_left }}</div>
      <div>{{ mel_footer_right }}</div>
    </div>
  </footer>
</div>
