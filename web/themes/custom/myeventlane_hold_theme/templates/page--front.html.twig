{#
/**
 * @file
 * Rebuilt MyEventLane holding page with distinct organiser and attendee paths.
 */
#}
<a class="mel-skip" href="#main-content">{{ 'Skip to content'|t }}</a>

<div class="mel-wrap mel2-page">
  <div class="mel2-wrap">
    <div class="mel-messages mel-messages--top" role="status" aria-live="polite">
      {{ mel_messages }}
    </div>
  </div>

  <header class="mel-header">
    <div class="mel-topbar">
      {% include '@myeventlane_hold_theme/includes/mel-brand.html.twig' %}

      <div class="mel-pill" role="status" aria-live="polite">
        <span class="mel-pill-dot" aria-hidden="true"></span>
        {{ mel_hero_kicker }}
      </div>
    </div>
  </header>

  <main id="main-content" class="mel2-main" role="main">
    <section class="mel2-section" aria-labelledby="mel2-hero-title">
      <div class="mel2-wrap">
        <div class="mel2-stack mel2-stack--wide">
          <h1 id="mel2-hero-title" class="mel2-h1">
            {{ mel_hero_gradient }} {{ mel_hero_subheading }}
          </h1>
          <p class="mel2-lead">{{ mel_hero_lead }}</p>
          <div class="mel2-doors" aria-label="{{ 'Choose how you use events'|t }}">
            <a class="mel2-btn mel2-btn--primary" href="#organisers">{{ 'I run events'|t }}</a>
            <a class="mel2-btn mel2-btn--quiet" href="#attendees">{{ 'I go to events'|t }}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="organisers" class="mel2-section" aria-labelledby="mel2-organisers-title">
      <div class="mel2-wrap">
        <div class="mel2-panel">
          <p class="mel2-eyebrow">{{ 'For organisers'|t }}</p>
          <h2 id="mel2-organisers-title" class="mel2-h2">{{ mel_organiser_panel_title }}</h2>
          <p class="mel2-lead">{{ mel_organiser_panel_intro }}</p>
          {% if mel_organiser_panel_points is not empty %}
            <ul class="mel2-points">
              {% for point in mel_organiser_panel_points %}
                <li>{{ point }}</li>
              {% endfor %}
            </ul>
          {% endif %}
          {{ waitlist_form_organiser }}
        </div>
      </div>
    </section>

    <section id="attendees" class="mel2-section" aria-labelledby="mel2-attendees-title">
      <div class="mel2-wrap">
        <div class="mel2-panel">
          <p class="mel2-eyebrow">{{ 'For attendees'|t }}</p>
          <h2 id="mel2-attendees-title" class="mel2-h2">{{ mel_attendee_panel_title }}</h2>
          <p class="mel2-lead">{{ mel_attendee_panel_intro }}</p>
          {{ waitlist_form_attendee }}
        </div>
      </div>
    </section>

    <section class="mel2-section" aria-labelledby="mel2-status-title">
      <div class="mel2-wrap">
        <div class="mel2-panel">
          <p class="mel2-eyebrow">{{ 'Launch status'|t }}</p>
          <h2 id="mel2-status-title" class="mel2-h2">{{ mel_status_title }}</h2>
          <div class="mel2-stack">
            {% for paragraph in mel_status_body %}
              <p class="mel2-lead">{{ paragraph }}</p>
            {% endfor %}
          </div>
          {% if mel_trust_items is not empty %}
            <ul class="mel2-trust" aria-label="{{ 'Our commitments'|t }}">
              {% for item in mel_trust_items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </section>

    <section class="mel2-section" aria-labelledby="mel2-contact-title">
      <div class="mel2-wrap">
        <div class="mel2-panel">
          <p class="mel2-eyebrow">{{ 'Contact'|t }}</p>
          <h2 id="mel2-contact-title" class="mel2-h2">{{ 'Have a question?'|t }}</h2>
          <p class="mel2-lead">{{ mel_whats_next_intro }}</p>
          <div class="mel2-doors" aria-label="{{ 'Contact and social links'|t }}">
            <a class="mel2-btn mel2-btn--primary" href="{{ path('myeventlane_waitlist.contact') }}">
              {{ 'Contact MyEventLane'|t }}
            </a>
            {% if mel_facebook_url %}
              <a class="mel2-btn mel2-btn--quiet" href="{{ mel_facebook_url }}" rel="noopener noreferrer" target="_blank">
                {{ 'Facebook'|t }}{% if mel_facebook_label %} — {{ mel_facebook_label }}{% endif %}
              </a>
            {% endif %}
            {% if mel_instagram_url %}
              <a class="mel2-btn mel2-btn--quiet" href="{{ mel_instagram_url }}" rel="noopener noreferrer" target="_blank">
                {{ 'Instagram'|t }}{% if mel_instagram_label %} — {{ mel_instagram_label }}{% endif %}
              </a>
            {% endif %}
            {% if mel_linkedin_url %}
              <a class="mel2-btn mel2-btn--quiet" href="{{ mel_linkedin_url }}" rel="noopener noreferrer" target="_blank">
                {{ 'LinkedIn'|t }}{% if mel_linkedin_label %} — {{ mel_linkedin_label }}{% endif %}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </main>

  {% include '@myeventlane_hold_theme/includes/mel-footer.html.twig' %}
</div>
