{#
/**
 * @file
 * Contact page — same shell as the holding page (brand header, card, footer).
 */
#}
<a class="mel-skip" href="#main-content">{{ 'Skip to content'|t }}</a>
<div class="mel-wrap">
  <div class="mel-messages mel-messages--top" role="status" aria-live="polite">
    {{ mel_messages }}
  </div>

  {% include '@myeventlane_hold_theme/includes/mel-header.html.twig' %}

  <main id="main-content" class="mel-main mel-main--contact" role="main">
    <header class="mel-hero-inner mel-hero-inner--art">
      <div class="mel-hero-inner__text">
        <h1 id="mel-contact-title" class="mel-hero-inner__title">{{ 'Contact MyEventLane'|t }}</h1>
        <p class="mel-hero-inner__lead">{{ "We'd love to hear from you."|t }}</p>
      </div>
      <img
        class="mel-hero-inner__art"
        src="{{ base_path }}{{ directory }}/images/mel-mascot-thinking.webp"
        alt=""
        aria-hidden="true"
        width="110"
        height="179"
        loading="lazy"
        decoding="async"
      />
    </header>

    <div class="mel-grid mel-grid--contact">
      <section class="mel-card mel-contact-page" aria-labelledby="mel-contact-title">
        {{ page.content }}
      </section>
    </div>
  </main>

  {% include '@myeventlane_hold_theme/includes/mel-footer.html.twig' %}
</div>
