{#
/**
 * @file
 * MyEventLane Hold global header.
 *
 * Uses mel_main_links prepared in myeventlane_hold_theme.theme so the header
 * never falls back to raw Drupal menu output.
 */
#}
<header class="mel-header mel-header--inner" role="banner">
  <div class="mel-topbar mel-topbar--nav">
    {% include '@myeventlane_hold_theme/includes/mel-brand.html.twig' %}

    <nav class="mel-nav" role="navigation" aria-label="{{ 'Main navigation'|t }}">
      <button
        class="mel-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mel-primary-nav"
        data-mel-nav-toggle
      >
        <span class="mel-nav__toggle-bar" aria-hidden="true"></span>
        <span class="mel-visually-hidden">{{ 'Menu'|t }}</span>
      </button>

      <div class="mel-nav__panel" id="mel-primary-nav" data-mel-nav-panel>
        <ul class="mel-nav__list" role="list">
          {% for item in mel_main_links %}
            <li class="mel-nav__item">
              {% if item.url %}
                <a class="mel-nav__link{{ item.is_active ? ' is-active' : '' }}" href="{{ item.url }}"{{ item.is_active ? ' aria-current="page"' : '' }}>
                  {{ item.title }}
                </a>
              {% else %}
                <span class="mel-nav__link mel-nav__link--nolink">{{ item.title }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  </div>
</header>
