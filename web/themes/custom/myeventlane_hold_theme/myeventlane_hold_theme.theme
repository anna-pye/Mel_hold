<?php

/**
 * @file
 * Theme hooks for MyEventLane Hold.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\myeventlane_waitlist\Form\WaitlistSignupForm;

/**
 * Builds a render array for a menu (enabled links only, access-checked).
 *
 * @return array<string, mixed>
 */
function myeventlane_hold_theme_build_menu(string $menu_name): array {
  $tree_service = \Drupal::menuTree();
  $parameters = new MenuTreeParameters();
  $parameters->onlyEnabledLinks();
  $tree = $tree_service->load($menu_name, $parameters);
  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $tree = $tree_service->transform($tree, $manipulators);
  return $tree_service->build($tree);
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function myeventlane_hold_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'myeventlane_waitlist.holding_home') {
    $suggestions[] = 'page__front';
  }
  if ($route === 'myeventlane_waitlist.contact') {
    $suggestions[] = 'page__mel_contact';
  }
}

/**
 * Parses badge lines into icon + main + sub (split on first •).
 *
 * @return array<int, array{icon: string, main: string, sub: string}>
 */
function myeventlane_hold_theme_parse_badges(string $badges_raw): array {
  $icon_order = ['calendar', 'ticketing', 'pin', 'layers'];
  $defaults = [
    ['main' => 'Event pages', 'sub' => 'simple to share'],
    ['main' => 'Free & paid events', 'sub' => 'flexible launch tools'],
    ['main' => 'RSVPs & ticketing', 'sub' => 'ready for early access'],
    ['main' => 'Built for communities', 'sub' => 'local organisers first'],
  ];
  $lines = array_values(array_filter(array_map('trim', preg_split('/\r\n|\r|\n/', $badges_raw))));
  $items = [];
  for ($i = 0; $i < 4; $i++) {
    $main = $defaults[$i]['main'];
    $sub = $defaults[$i]['sub'];
    if (!empty($lines[$i])) {
      if (preg_match('/^(.+?)\s*•\s*(.+)$/u', $lines[$i], $m)) {
        $main = trim($m[1]);
        $sub = trim($m[2]);
      }
      else {
        $main = $lines[$i];
        $sub = '';
      }
    }
    $items[] = [
      'icon' => $icon_order[$i],
      'main' => $main,
      'sub' => $sub,
    ];
  }
  return $items;
}

/**
 * Implements hook_preprocess_page().
 */
function myeventlane_hold_theme_preprocess_page(array &$variables): void {
  $variables['mel_messages'] = ['#type' => 'status_messages'];

  $config = \Drupal::config('myeventlane_hold_theme.settings');

  $variables['mel_brand_subtitle'] = $config->get('brand_subtitle') ?: 'early access';
  $variables['mel_hero_kicker'] = $config->get('hero_kicker') ?: 'Early access opening soon';

  $hero_gradient = $config->get('hero_gradient');
  if ($hero_gradient === NULL || $hero_gradient === '') {
    $hero_gradient = $config->get('hero_title') ?: 'Discover and run local events';
  }
  $variables['mel_hero_gradient'] = $hero_gradient;

  $hero_subheading = $config->get('hero_subheading');
  if ($hero_subheading === NULL || $hero_subheading === '') {
    $hero_subheading = 'with MyEventLane';
  }
  $variables['mel_hero_subheading'] = $hero_subheading;

  $variables['mel_hero_lead'] = $config->get('hero_lead') ?: '';

  $badges_raw = (string) ($config->get('badges') ?: '');
  $variables['mel_badge_items'] = myeventlane_hold_theme_parse_badges($badges_raw);

  $waitlist_intro = $config->get('waitlist_intro');
  if ($waitlist_intro === NULL || $waitlist_intro === '') {
    $waitlist_intro = 'Join the early list for launch updates and first access when MyEventLane opens.';
  }
  $variables['mel_waitlist_intro'] = $waitlist_intro;

  $whats_next_intro = $config->get('whats_next_intro');
  if ($whats_next_intro === NULL || $whats_next_intro === '') {
    $legacy = $config->get('whats_next');
    $whats_next_intro = $legacy ? trim(html_entity_decode(strip_tags((string) $legacy), ENT_QUOTES | ENT_HTML5, 'UTF-8')) : '';
    if ($whats_next_intro === '') {
      $whats_next_intro = 'Have a launch question or want to introduce your community? Contact MyEventLane and we’ll get back to you.';
    }
  }
  $variables['mel_whats_next_intro'] = $whats_next_intro;

  $footer_left = $config->get('footer_line_left');
  if ($footer_left === NULL || $footer_left === '') {
    $footer_left = $config->get('footer_note') ?: '© @year MyEventLane. All rights reserved.';
  }
  $variables['mel_footer_left'] = str_replace('@year', (string) date('Y'), (string) $footer_left);

  $footer_right = $config->get('footer_line_right');
  if ($footer_right === NULL || $footer_right === '') {
    $footer_right = 'Built in Australia for community events.';
  }
  $variables['mel_footer_right'] = $footer_right;

  $variables['mel_facebook_url'] = $config->get('facebook_url') ?: '';
  $variables['mel_facebook_label'] = $config->get('facebook_label') ?: 'MyEventLane';
  $variables['mel_instagram_url'] = $config->get('instagram_url') ?: '';
  $variables['mel_instagram_label'] = $config->get('instagram_label') ?: '@myeventlane';
  $variables['mel_linkedin_url'] = $config->get('linkedin_url') ?: '';
  $variables['mel_linkedin_label'] = $config->get('linkedin_label') ?: 'MyEventLane';
  // Only show the footer Social column when at least one URL is configured.
  $variables['mel_has_social'] = ($variables['mel_facebook_url'] !== '')
    || ($variables['mel_instagram_url'] !== '')
    || ($variables['mel_linkedin_url'] !== '');

  // Global header nav + multi-column footer for inner pages.
  $variables['mel_main_menu'] = myeventlane_hold_theme_build_menu('main');
  $variables['mel_footer_menu'] = myeventlane_hold_theme_build_menu('footer');

  // Resolve the current page title for inner templates (the page_title block
  // lives in an unrendered region, so inner pages need an explicit H1).
  $request = \Drupal::request();
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route !== NULL) {
    $title = \Drupal::service('title_resolver')->getTitle($request, $route);
    $variables['mel_page_title'] = is_array($title) ? \Drupal::service('renderer')->renderInIsolation($title) : $title;
  }

  if (\Drupal::routeMatch()->getRouteName() === 'myeventlane_waitlist.holding_home') {
    $variables['is_front'] = TRUE;
  }

  if (!empty($variables['is_front'])) {
    $variables['waitlist_form'] = \Drupal::formBuilder()->getForm(WaitlistSignupForm::class);
  }

  $waitlist = \Drupal::config('myeventlane_waitlist.settings');
  $variables['mel_privacy_url'] = $waitlist->get('privacy_url') ?: '/privacy';
}

/**
 * Implements hook_preprocess_html().
 */
function myeventlane_hold_theme_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'mel-root';
  $variables['html_attributes']['lang'] = 'en-AU';
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Environment-based robots and theme-color remain theme-owned; all other SEO
 * tags are emitted by Metatag (Configuration → Search and Metadata → Metatag).
 */
function myeventlane_hold_theme_page_attachments_alter(array &$attachments): void {
  /** @var \Drupal\Core\Site\Settings $siteSettings */
  $siteSettings = \Drupal::service('settings');
  $env = (string) ($siteSettings->get('mel.environment') ?: 'local');

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'theme-color',
        'content' => '#f6f4ff',
      ],
    ],
    'mel_theme_color',
  ];

  $indexable_environments = ['production'];
  $robots_content = in_array($env, $indexable_environments, TRUE)
    ? 'index, follow'
    : 'noindex, nofollow';
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'robots',
        'content' => $robots_content,
      ],
    ],
    'mel_robots',
  ];
}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function myeventlane_hold_theme_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state, $form_id = NULL): void {
  $theme_name = $form_state->getBuildInfo()['args'][0] ?? '';
  if ($theme_name !== 'myeventlane_hold_theme') {
    return;
  }
  $theme = \Drupal::configFactory()->getEditable('myeventlane_hold_theme.settings');
  $form['mel'] = [
    '#type' => 'details',
    '#title' => t('MyEventLane holding page'),
    '#open' => TRUE,
  ];
  $form['mel']['brand_subtitle'] = [
    '#type' => 'textfield',
    '#title' => t('Brand subtitle (under logo)'),
    '#default_value' => $theme->get('brand_subtitle'),
  ];
  $form['mel']['hero_kicker'] = [
    '#type' => 'textfield',
    '#title' => t('Status pill text'),
    '#default_value' => $theme->get('hero_kicker'),
  ];
  $form['mel']['hero_gradient'] = [
    '#type' => 'textfield',
    '#title' => t('Hero gradient line (first line of headline)'),
    '#default_value' => $theme->get('hero_gradient'),
    '#description' => t('Replaces legacy “Hero headline” if set.'),
  ];
  $form['mel']['hero_subheading'] = [
    '#type' => 'textfield',
    '#title' => t('Hero second line'),
    '#default_value' => $theme->get('hero_subheading'),
  ];
  $form['mel']['hero_lead'] = [
    '#type' => 'textarea',
    '#title' => t('Supporting lead paragraph'),
    '#default_value' => $theme->get('hero_lead'),
  ];
  $form['mel']['badges'] = [
    '#type' => 'textarea',
    '#title' => t('Feature badges (up to four lines: “Main • Sub”)'),
    '#default_value' => $theme->get('badges'),
  ];
  $form['mel']['waitlist_intro'] = [
    '#type' => 'textarea',
    '#title' => t('Waitlist panel intro'),
    '#default_value' => $theme->get('waitlist_intro'),
  ];
  $form['mel']['waitlist_fineprint'] = [
    '#type' => 'textarea',
    '#title' => t('Waitlist fine print (under email row)'),
    '#default_value' => $theme->get('waitlist_fineprint'),
  ];
  $form['mel']['whats_next_intro'] = [
    '#type' => 'textarea',
    '#title' => t('“What’s next” intro paragraph'),
    '#default_value' => $theme->get('whats_next_intro'),
  ];
  $form['mel']['facebook_url'] = [
    '#type' => 'url',
    '#title' => t('Facebook URL'),
    '#default_value' => $theme->get('facebook_url'),
    '#description' => t('Leave empty to hide the Facebook link. The footer Social column is hidden entirely when no social URLs are set.'),
  ];
  $form['mel']['facebook_label'] = [
    '#type' => 'textfield',
    '#title' => t('Facebook label'),
    '#default_value' => $theme->get('facebook_label'),
  ];
  $form['mel']['instagram_url'] = [
    '#type' => 'url',
    '#title' => t('Instagram URL'),
    '#default_value' => $theme->get('instagram_url'),
  ];
  $form['mel']['instagram_label'] = [
    '#type' => 'textfield',
    '#title' => t('Instagram label (e.g. @handle)'),
    '#default_value' => $theme->get('instagram_label'),
  ];
  $form['mel']['linkedin_url'] = [
    '#type' => 'url',
    '#title' => t('LinkedIn URL'),
    '#default_value' => $theme->get('linkedin_url'),
  ];
  $form['mel']['linkedin_label'] = [
    '#type' => 'textfield',
    '#title' => t('LinkedIn label'),
    '#default_value' => $theme->get('linkedin_label'),
  ];
  $form['mel']['footer_line_left'] = [
    '#type' => 'textfield',
    '#title' => t('Footer line (left). Use @year for current year.'),
    '#default_value' => $theme->get('footer_line_left'),
  ];
  $form['mel']['footer_line_right'] = [
    '#type' => 'textfield',
    '#title' => t('Footer line (right)'),
    '#default_value' => $theme->get('footer_line_right'),
  ];

  $form['#submit'][] = 'myeventlane_hold_theme_settings_submit';
}

/**
 * Saves theme settings.
 */
function myeventlane_hold_theme_settings_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::configFactory()->getEditable('myeventlane_hold_theme.settings')
    ->set('brand_subtitle', $form_state->getValue('brand_subtitle'))
    ->set('hero_kicker', $form_state->getValue('hero_kicker'))
    ->set('hero_gradient', $form_state->getValue('hero_gradient'))
    ->set('hero_subheading', $form_state->getValue('hero_subheading'))
    ->set('hero_lead', $form_state->getValue('hero_lead'))
    ->set('badges', $form_state->getValue('badges'))
    ->set('waitlist_intro', $form_state->getValue('waitlist_intro'))
    ->set('waitlist_fineprint', $form_state->getValue('waitlist_fineprint'))
    ->set('whats_next_intro', $form_state->getValue('whats_next_intro'))
    ->set('facebook_url', $form_state->getValue('facebook_url'))
    ->set('facebook_label', $form_state->getValue('facebook_label'))
    ->set('instagram_url', $form_state->getValue('instagram_url'))
    ->set('instagram_label', $form_state->getValue('instagram_label'))
    ->set('linkedin_url', $form_state->getValue('linkedin_url'))
    ->set('linkedin_label', $form_state->getValue('linkedin_label'))
    ->set('footer_line_left', $form_state->getValue('footer_line_left'))
    ->set('footer_line_right', $form_state->getValue('footer_line_right'))
    ->save();
}

/**
 * Implements hook_form_FORM_ID_alter() for waitlist_signup_form.
 */
function myeventlane_hold_theme_form_waitlist_signup_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id !== 'waitlist_signup_form') {
    return;
  }

  if (empty($form['email']) || empty($form['actions']['submit'])) {
    return;
  }

  $form['email']['#title'] = t('Email address');
  $form['email']['#title_display'] = 'before';

  $submit = $form['actions']['submit'];
  $submit['#value'] = t('Join the waitlist');
  unset($form['actions']);

  $form['row'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['mel-waitlist-form__row']],
    '#weight' => 0,
  ];
  $form['row']['email'] = $form['email'];
  unset($form['email']);
  $form['row']['actions'] = [
    '#type' => 'actions',
    'submit' => $submit,
  ];

  $theme_config = \Drupal::config('myeventlane_hold_theme.settings');
  $fineprint = (string) ($theme_config->get('waitlist_fineprint') ?: '');
  $form['fineprint'] = [
    '#type' => 'markup',
    '#markup' => '<p class="mel-fineprint">' . Html::escape($fineprint) . '</p>',
    '#weight' => 2,
  ];

  $form['consent']['#weight'] = 3;

  $privacy = \Drupal::config('myeventlane_waitlist.settings')->get('privacy_url') ?: '/privacy';
  $form['panel_legal'] = [
    '#type' => 'markup',
    '#markup' => '<p class="mel-panel-legal"><a href="' . Html::escape($privacy) . '">' . t('Privacy') . '</a></p>',
    '#weight' => 4,
  ];

  $form['website']['#weight'] = -20;
  $form['interest_type']['#weight'] = -15;
  foreach (['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#weight'] = -15;
    }
  }
  $form['form_variant']['#weight'] = 10;
}
