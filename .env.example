# Copy to .env and adjust. Docker Compose reads this file automatically.

# HTTP port on localhost (site: http://localhost:PORT)
MEL_HTTP_PORT=8080

# MariaDB (matches web/sites/default/settings.php env vars)
DRUPAL_DATABASE_NAME=drupal
DRUPAL_DATABASE_USERNAME=drupal
DRUPAL_DATABASE_PASSWORD=drupal
DRUPAL_DATABASE_ROOT_PASSWORD=root
DRUPAL_DATABASE_HOST=db
DRUPAL_DATABASE_PORT=3306

# Expose MariaDB to host (optional)
MEL_DB_PORT=3306

# Public base URL used by Drupal (no trailing slash)
DRUPAL_BASE_URL=http://localhost:8080

# Required after install: use `openssl rand -hex 32` (or Drush hash)
DRUPAL_HASH_SALT=

# Secrets — never commit real values
WAITLIST_TOKEN_SECRET=
WAITLIST_IP_PEPPER=

# local | production — affects robots / meta indexing.
# Production hosts MUST set MEL_ENVIRONMENT=production or the live site stays noindex.
MEL_ENVIRONMENT=local

# php | smtp | sendmail — informational; Docker uses mhsendmail → Mailhog
MEL_MAIL_MODE=php

# Mailhog UI
MEL_MAILHOG_UI_PORT=8025
MEL_MAILHOG_SMTP_PORT=1025