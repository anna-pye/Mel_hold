# Copy to deploy/deploy.env and fill in (deploy/deploy.env is gitignored).
# Used by deploy/push-and-deploy.sh

# Production server (SSH hostname).
MEL_DEPLOY_HOST=myeventlane.com.au

# Account you SSH in as (root@myeventlane.com.au → su mel on the server).
MEL_SSH_USER=root

# Unix user that owns the site files and runs composer/drush.
MEL_DEPLOY_RUN_AS=mel

# Git branch deployed to production.
MEL_DEPLOY_BRANCH=main

# Project root on the server (composer.json lives here).
# cPanel holding site: mel's home directory (/home/mel) — usually NOT a git repo.
# NEVER set this to staging paths (/home/mel/staging, /home/mel/staging/current,
# /home/mel/staging-repo). Staging is a separate deployment and is off limits.
MEL_DEPLOY_PATH=/home/mel

# rsync = push to GitHub then rsync files to server (cPanel / no .git on server).
# git   = server has git clone and pulls from GitHub (VPS). Default stays rsync.
#
# Future Git migration (holding site only — do not enable without a planned cutover):
#   1. Clone this repository on the production server at a holding-site path (e.g. /home/mel).
#   2. Confirm the path is NOT under /home/mel/staging* and post-deploy-verify passes manually.
#   3. Set MEL_DEPLOY_METHOD=git here and run push-and-deploy once while watching output.
#   4. Keep rsync as rollback until Git-based deploy is proven on production.
MEL_DEPLOY_METHOD=rsync

# Git remote on your machine.
MEL_GIT_REMOTE=origin

# Set to 1 to skip git push (e.g. you already pushed).
# MEL_DEPLOY_SKIP_PUSH=0

# Set to 1 to skip post-deploy verification (drush status, config:status, sitemap).
# MEL_DEPLOY_SKIP_VERIFY=0
