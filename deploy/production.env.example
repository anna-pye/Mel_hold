# Copy to /etc/myeventlane/production.env on the server (chmod 640, root:www-data).
# PHP-FPM and interactive shells should load this (see deploy/bootstrap-debian-ubuntu.sh).

# MariaDB (match database user you create in MySQL)
DRUPAL_DATABASE_NAME=drupal
DRUPAL_DATABASE_USERNAME=drupal
DRUPAL_DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DRUPAL_DATABASE_HOST=127.0.0.1
DRUPAL_DATABASE_PORT=3306

# Public URL (https, no trailing slash)
DRUPAL_BASE_URL=https://myeventlane.com.au

# Canonical origin for CLI-generated absolute URLs (Drush native --uri override).
# Drush/cron/queue workers have no HTTP request, so without this Drupal emits
# http://default/... in links built from cron (e.g. waitlist confirmation emails).
# Set to the same origin as DRUPAL_BASE_URL. Web requests are unaffected (they use
# the real request host). Staging/other environments set their own value in their
# own env file, so this stays environment-independent with no hardcoding in code.
DRUSH_OPTIONS_URI=https://myeventlane.com.au

# openssl rand -hex 32 (each)
DRUPAL_HASH_SALT=
WAITLIST_TOKEN_SECRET=

# Optional extra pepper for IP hashing
WAITLIST_IP_PEPPER=

# production → allow indexing / production meta (see theme)
MEL_ENVIRONMENT=production

# smtp | sendmail | php — configure real mail on the server (Postfix, relay, etc.)
MEL_MAIL_MODE=sendmail
