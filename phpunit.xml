<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for MyEventLane custom module tests.
  Run inside DDEV:  ddev exec vendor/bin/phpunit
  Kernel tests use a throwaway SQLite database; no site DB is touched.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="web/core/tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="false"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnWarning="false">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <env name="SIMPLETEST_BASE_URL" value="http://localhost"/>
    <env name="SIMPLETEST_DB" value="sqlite://localhost//tmp/mel-phpunit.sqlite"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp"/>
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
  </php>
  <testsuites>
    <testsuite name="myeventlane">
      <directory>web/modules/custom/*/tests/src</directory>
    </testsuite>
  </testsuites>
</phpunit>
